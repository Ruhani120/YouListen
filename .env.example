# =================================================================
# YouListen - Root Environment Variables Template (.env.example)
# Copy this file to .env for custom local settings
# Note: Docker Compose has built-in defaults and works out of the box.
# =================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=harmonysync
DB_USERNAME=youlisten
DB_PASSWORD=youlisten_dev

# Backend Security
JWT_SECRET=youlisten-dev-jwt-secret-must-be-at-least-256-bits-long-for-hs256
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Backend Server
SERVER_PORT=8080

# Frontend API Endpoint
VITE_API_BASE_URL=http://localhost:8080
