# Copy to .env on the EC2 server and fill in. NEVER commit the real .env file.

# Your public address (no https://, no trailing slash)
DOMAIN=youlisten.duckdns.org

# Amazon RDS (endpoint is on the RDS database page)
DB_HOST=youlisten-db.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
DB_NAME=harmonysync
DB_USERNAME=youlisten
DB_PASSWORD=

# Long random values. Generate with:  openssl rand -base64 48
JWT_SECRET=
# 16+ characters. Do not change later, or saved Spotify/Google logins stop working.
SPOTIFY_TOKEN_ENCRYPTION_KEY=

# Spotify dashboard + Google Cloud credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
