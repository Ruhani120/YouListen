# =================================================================
# YouListen - Backend Environment Variables Template (.env.example)
# =================================================================

# Spring Profile
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Datasource
DB_HOST=localhost
DB_PORT=5432
DB_NAME=harmonysync
DB_USERNAME=youlisten
DB_PASSWORD=youlisten_dev

# JWT Secret (HS256 requires minimum 256 bits)
JWT_SECRET=youlisten-dev-jwt-secret-must-be-at-least-256-bits-long-for-hs256

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server Port
SERVER_PORT=8080
