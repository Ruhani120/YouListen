# =================================================================
# YouListen - Backend Environment Variables Template (.env.example)
# =================================================================

# Spring Profile
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Datasource
DB_HOST=localhost
DB_PORT=5432
DB_NAME=harmonysync
DB_USERNAME=youlisten
DB_PASSWORD=youlisten_dev

# JWT Secret (HS256 requires minimum 256 bits)
JWT_SECRET=youlisten-dev-jwt-secret-must-be-at-least-256-bits-long-for-hs256

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server Port
SERVER_PORT=8080

# Spotify OAuth (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI in the Spotify dashboard EXACTLY (use 127.0.0.1, not localhost, for local dev)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/spotify/callback
# Where the backend sends the browser after Spotify login
FRONTEND_URL=http://localhost:3001
# Any random string, 16+ characters. Used to encrypt Spotify tokens in the database.
SPOTIFY_TOKEN_ENCRYPTION_KEY=

# Google / YouTube (https://console.cloud.google.com : enable "YouTube Data API v3", create an OAuth client of type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorised redirect URI" on the OAuth client EXACTLY
GOOGLE_REDIRECT_URI=http://localhost:8080/api/google/callback
# Optional API key: lets song matching search YouTube without the user connecting Google first
YOUTUBE_API_KEY=
